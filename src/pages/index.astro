---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import { site } from '../data/site';

// Hero is built. `#stack` and `#contact` below are still ANCHOR PLACEHOLDERS —
// each gets replaced wholesale by its own approved step (PHASES.md Phase 1).
const placeholders = [
  { id: 'stack', label: 'stack' },
  { id: 'contact', label: 'contact' },
] as const;
---

<Base title={site.meta.title} description={site.meta.description}>
  <Nav slot="nav" />

  <Hero />

  {
    placeholders.map(({ id, label }) => (
      <section id={id} tabindex="-1" class="py-section border-border border-b last:border-b-0">
        <p class="text-fg-muted font-mono text-sm">
          <span class="text-accent">#{id}</span> — {label} section pending
        </p>
      </section>
    ))
  }
</Base>
