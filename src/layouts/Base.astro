---
import '../styles/global.css';

// Same file the @font-face in global.css points at, so Vite emits one asset and
// the preload URL matches the one the stylesheet requests.
//
// Only the sans is preloaded. The mono is used selectively (technical/system
// elements, mostly below the fold) and shouldn't compete with first paint.
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import SourceView from '../components/SourceView.astro';
import TerminalLoader from '../components/TerminalLoader.astro';
import { site } from '../data/site';
import { themeCss } from '../data/themes';

interface Props {
  title: string;
  description: string;
  /** Path-only, e.g. "/achievements". Resolved against `site` in astro.config.mjs. */
  path?: string;
}

const { title, description, path = '/' } = Astro.props;

// Only bind when this page really is showing the site's own metadata. The 404
// passes its own title, and editing `meta.title` should not rewrite that.
const titlePath = title === site.meta.title ? 'meta.title' : undefined;
const descriptionPath = description === site.meta.description ? 'meta.description' : undefined;
const canonical = new URL(path, Astro.site);

// Social scrapers do not resolve relative URLs, so og:image must be absolute.
// It resolves against `site` in astro.config.mjs — which is still a placeholder
// domain, so this is one of the things to fix before launch.
const ogImage = new URL('/og.png', Astro.site);
const OG_IMAGE_ALT = `${site.name} — ${site.role}. ${site.pitch.lead}.`;
---

<!doctype html>
<html lang="en" class="scheme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {
      /* `<title>` binds by text like anything else — setting its textContent is
        what changes the browser tab, which makes it the most visible edit on
        the page that is not on the page. */
    }
    <title data-bind={titlePath}>{title}</title>
    <meta name="description" content={description} data-bind-content={descriptionPath} />
    <link rel="canonical" href={canonical} />

    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0c0e" />

    {
      /* Open Graph. Twitter reads these too, so only the card type and the alt
        text need repeating under the twitter: prefix. */
    }
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} data-bind-content={titlePath} />
    <meta property="og:description" content={description} data-bind-content={descriptionPath} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />

    {
      /* Palette presets. Generated from src/data/themes.ts so the hex values
        exist once, and emitted unlayered so these rules beat Tailwind's
        `@layer theme`. Each rule sets only the three seeds — every other token
        is a color-mix() of them and follows without being mentioned. */
    }
    <style is:inline set:html={themeCss}></style>

    <slot name="head" />
  </head>

  <body class="min-h-dvh">
    {
      /* Source-view switch. It is first in <body> so sibling selectors in
        global.css can reach everything it controls. Zero JS — a real checkbox,
        so it is keyboard-operable and announced correctly for free. */
    }
    <input type="checkbox" id="source-view" class="sr-only" />

    <a
      href="#main"
      class="focus:bg-surface focus:text-fg sr-only rounded-sm focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2"
    >
      Skip to content
    </a>

    <slot name="nav" />

    <main id="main" class="gutter w-full">
      <slot />
    </main>

    <slot name="footer" />

    <SourceView />

    <TerminalLoader />

    <label for="source-view" class="source-toggle" title="Toggle source view">
      <span class="glyph" aria-hidden="true">{'{ }'}</span>
      <span class="when-off sr-only">View source data</span>
      <span class="when-on sr-only">Back to the site</span>
    </label>
  </body>
</html>
