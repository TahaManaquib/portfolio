---
// The machine view, revealed when the bottom-right toggle is on.
//
// Same data as the human view — both read from `site`. Nothing is retyped.
//
// The reveal is a checkbox in Base.astro plus sibling selectors in global.css,
// and the palette presets are a radio group that `html:has(#theme-x:checked)`
// carries up to `:root`. Both need no JavaScript at all. A custom colour picker
// briefly lived here too and was removed at Taha's request.
//
// Editing is the exception, and the only script this component loads: values
// are editable in place and arrays can grow and shrink, live-bound to the human
// view. It waits for the view to actually open — a recruiter who never flips the
// toggle pays for one listener and nothing else. See src/islands/edit/mount.ts.
import { site } from '../data/site';
import { machineRequestLine, machineStatusLines } from '../data/machine';
import { THEMES, FEATURED, SHAPE_OF, DEFAULT_THEME, contrast, readout } from '../data/themes';
import JsonNode from './JsonNode.astro';

// Built here rather than inline in the template: a `.join('\n')` inside the
// markup is easy to mangle, and the frontmatter is where logic belongs.
const framing = [machineRequestLine, '', ...machineStatusLines].join('\n');

// The contrast readout is mandatory, not decorative (CLAUDE.md): a palette
// control on a site with a hard AA floor has to show its work. Presets are
// known at build time, so this costs nothing at runtime.
const readouts = THEMES.map((theme) => ({
  id: theme.id,
  text: readout([
    ['text', contrast(theme.fg, theme.bg)],
    ['accent', contrast(theme.accent, theme.bg)],
  ]),
}));
---

<div class="source-view gutter">
  {
    /* The radios sit here rather than beside their labels so `~` can reach the
      header from them. `for`/`id` still pairs them up, and the labels render up
      in the control strip where they belong.

      All twelve are rendered even though only four are labelled: an unlabelled
      radio is still checkable, which is exactly what lets the terminal select a
      palette the source view does not advertise. */
  }
  {
    THEMES.map((theme) => (
      <input
        type="radio"
        name="theme"
        id={`theme-${theme.id}`}
        class="sr-only"
        checked={theme.id === DEFAULT_THEME.id}
        data-polarity={theme.polarity}
        data-shape={SHAPE_OF[theme.id] ?? 'clean'}
        {...(FEATURED.includes(theme.id)
          ? {}
          : /* The eight unlisted palettes have no label, by design — they are
               reachable only through the terminal's `theme` command. Without
               this they were eight unnamed radios in the tab order, which axe
               flags and which is genuinely worse than hiding them: a
               screen-reader visitor met eight controls with nothing to
               distinguish them. Hidden from assistive tech and out of the tab
               order, they are still checkable programmatically, which is all
               the command needs and all the `:has()` selector cares about. */
            { tabindex: '-1', 'aria-hidden': 'true' })}
      />
    ))
  }

  <div class="head">
    <pre class="framing">{framing}</pre>

    {
      /* Colours are viewer settings, so the control lives up here in the header
        and never in the JSON body — putting `theme.accent` in the payload would
        quietly turn GET /taha from a profile response into a config document. */
    }
    <div class="controls">
      <div class="row">
        <span class="ctl">palette</span>
        <div class="choices" role="group" aria-label="Palette">
          {
            /* Only the featured palettes get a label. The rest have radios (see
              above) but no control on screen — they are reachable from the
              terminal's `theme` command, which reads the radios rather than a
              list of its own, so the two can never disagree about what exists. */
            THEMES.filter((theme) => FEATURED.includes(theme.id)).map((theme) => (
              <label for={`theme-${theme.id}`}>{theme.label}</label>
            ))
          }
        </div>
      </div>

      {
        /* Stays hidden until there is something to reset — a control that does
          nothing is noise, and this strip is meant to be quiet. */
      }
      <div class="row" data-edit-row hidden>
        <span class="ctl">edits</span>
        <button type="button" class="edit-reset" data-edit-reset>reset</button>
      </div>

      <p class="contrast">
        {readouts.map((r) => <span class={`ct ct-${r.id}`}>{r.text}</span>)}
      </p>
    </div>
  </div>

  <div class="tree">
    <JsonNode value={site} />
  </div>
</div>

<script>
  // Editing is the one thing in here that genuinely cannot be done in CSS, so
  // it is also the only script the source view loads — and it waits until the
  // view is actually opened. A recruiter who never flips the toggle pays for
  // the listener below and nothing else.
  const toggle = document.getElementById('source-view');
  const view = document.querySelector<HTMLElement>('.source-view');
  if (toggle instanceof HTMLInputElement && view) {
    let loading: Promise<void> | null = null;
    toggle.addEventListener('change', () => {
      if (!toggle.checked) return;
      loading ??= import('../islands/edit/mount').then((m) => m.mountEditor(view));
    });
  }
</script>

<style>
  .source-view {
    position: relative;
    z-index: 1;
    padding-block: 2rem 6rem;
    font-family: var(--font-mono);
    line-height: 1.7;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
    border-bottom: var(--border-w) var(--border-style) var(--color-border);
  }

  .framing {
    margin: 0;
    font-size: 12px;
    color: var(--color-fg-muted);
    white-space: pre-wrap;
  }

  .controls {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* fg-muted, not fg-subtle: a label a visitor reads, at 3.19:1 otherwise. */
  .ctl {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }

  /* Named, not swatches. A row of colour chips was tried and reverted at Taha's
     request: the names are the point — "amber" and "azure" say what they are,
     where twelve anonymous squares make you click each one to find out. They
     wrap to a second row rather than being abbreviated. */
  .choices {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem;
  }

  .choices label {
    display: inline-flex;
    min-width: 2.25rem;
    min-height: 2.25rem;
    align-items: center;
    justify-content: center;
    padding-inline: 0.6rem;
    border: var(--border-w) var(--border-style) var(--color-border);
    border-radius: var(--radius);
    font-size: 11px;
    color: var(--color-fg-muted);
    cursor: pointer;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .choices label:hover {
    color: var(--color-fg);
  }

  .edit-reset {
    border: 0;
    background: none;
    padding: 0;
    font-family: inherit;
    font-size: 11px;
    color: var(--color-fg-muted);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-border-strong);
    transition: color 150ms ease;
  }

  .edit-reset:hover {
    color: var(--color-fg);
  }

  .contrast {
    margin: 0.25rem 0 0;
    font-size: 10px;
    color: var(--color-fg-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Only the selected palette's figures are shown. */
  .ct {
    display: none;
  }

  /* The per-palette rules — which swatch each label paints, which one reads as
     selected, and which contrast figures show — are generated in themes.ts and
     emitted by Base.astro. A sibling combinator cannot be parameterised in CSS,
     so at a dozen palettes writing them here by hand meant three dozen lines
     kept in step manually; generating them is the same reason the seed rules
     are generated. */

  /* Fixed, not adjustable. The size control that used to sit here was removed:
     11px is the size this is designed at, and it is scoped to the JSON so it was
     never a site-wide type control either way. */
  .tree {
    font-size: 11px;
  }
</style>
