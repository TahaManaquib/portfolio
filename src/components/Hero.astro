---
// Hero — name, role, one-line pitch, CTA, with About folded in briefly.
// No separate About section/page (CLAUDE.md).
//
// Renders entirely from src/data/site.ts. No content is written here.
import { site } from '../data/site';

const { name, role, pitch, proof, availability } = site;

/**
 * Oxford-comma separators, so the accent spans can be interleaved with plain
 * text instead of the sentence being stored as markup.
 */
function separatorAfter(index: number, total: number): string {
  if (index === total - 1) return '';
  if (index === total - 2) return ', and ';
  return ', ';
}
---

<section id="top" tabindex="-1" class="border-border py-section-sm sm:py-section border-b">
  <p class="text-fg-muted font-mono text-xs tracking-wider uppercase" data-bind="role">{role}</p>

  <h1 class="text-display text-fg mt-4 font-medium" data-bind="name">{name}</h1>

  {
    /* Emitted as one array expression, not as sibling template nodes: Astro
      keeps whitespace between siblings (unlike JSX, which strips newlines), so
      an indented <span> on its own line renders as "authorization , billing".
      Array items have no whitespace between them. */
  }
  <p class="text-fg mt-6 max-w-2xl text-lg text-balance sm:text-xl" data-bind-join="comma-and">
    {
      [
        <span data-bind="pitch.lead" set:text={pitch.lead} />,
        ' — ',
        ...pitch.highlights.flatMap((term, i) => [
          <span class="text-accent" data-bind={`pitch.highlights.${i}`} set:text={term} />,
          separatorAfter(i, pitch.highlights.length),
        ]),
        '.',
      ]
    }
  </p>

  <ul class="mt-8 flex flex-wrap gap-2">
    {
      proof.map((item, i) => (
        <li
          class="border-border text-fg-muted rounded-sm border px-2.5 py-1.5 font-mono text-xs"
          data-bind={`proof.${i}`}
        >
          {item}
        </li>
      ))
    }
  </ul>

  {
    availability.open && (
      <p class="text-fg-muted mt-10 flex items-center gap-2 font-mono text-xs tracking-wider uppercase">
        <span class="bg-accent size-1.5 shrink-0 rounded-full" aria-hidden="true" />
        <span data-bind="availability.label">{availability.label}</span>
      </p>
    )
  }

  <a
    href="#contact"
    class="border-border text-fg hover:border-accent-dim hover:text-accent group mt-4 inline-flex min-h-11 items-center gap-2 rounded-sm border px-4 text-sm transition-colors duration-150"
  >
    Get in touch
    <span aria-hidden="true" class="transition-transform duration-150 group-hover:translate-x-0.5"
      >&rarr;</span
    >
  </a>
</section>
