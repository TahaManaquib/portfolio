---
// One node of the JSON tree, rendered recursively via <Astro.self />.
//
// Branches (objects/arrays) are native <details>/<summary>, so collapsing is
// real HTML with real keyboard support and zero JS. Collapsed nodes show a
// count the way a real JSON viewer does: `"stack": {…} 2 keys`.
//
// Whitespace warning: Astro preserves whitespace between sibling template
// nodes (unlike JSX, which strips newlines), so an indented <span> on its own
// line renders as a stray space mid-token. Every inline run below is therefore
// emitted as a single array expression. Block-level children are safe —
// whitespace between blocks collapses away.
interface Props {
  /** Object key. Absent for array elements and for the root. */
  name?: string;
  value: unknown;
  /** Controls the trailing comma. */
  last?: boolean;
  /**
   * Dotted path to this node from the root, e.g. `stack.primary.0.label`.
   * It is what pairs a value in here with the element rendering it out in the
   * human view — the same key on both sides of the two representations.
   */
  path?: string;
}

const { name, value, last = true, path = '' } = Astro.props;

const childPath = (key: string | undefined, index: number) =>
  path ? `${path}.${key ?? index}` : `${key ?? index}`;

const isArray = Array.isArray(value);
const isObject = typeof value === 'object' && value !== null && !isArray;
const isBranch = isArray || isObject;

const entries: [string | undefined, unknown][] = isArray
  ? (value as unknown[]).map((v) => [undefined, v])
  : isObject
    ? Object.entries(value as Record<string, unknown>)
    : [];

const openBrace = isArray ? '[' : '{';
const closeBrace = isArray ? ']' : '}';
const n = entries.length;
const countLabel = isArray ? `${n} item${n === 1 ? '' : 's'}` : `${n} key${n === 1 ? '' : 's'}`;

function tokenClass(v: unknown): string {
  if (typeof v === 'string') return 'tok-str';
  if (typeof v === 'number') return 'tok-num';
  return 'tok-bool';
}

const literal = typeof value === 'string' ? JSON.stringify(value) : String(value);

const keyParts = name === undefined ? [] : [`"${name}"`];
---

{
  /* Empty object or array: no point in a disclosure widget. */
  isBranch && n === 0 && (
    <div class="row">
      {[
        ...keyParts.map((k) => <span class="tok-key">{k}</span>),
        name === undefined ? null : <span class="tok-p colon">:</span>,
        <span class="tok-p">{openBrace + closeBrace}</span>,
        last ? null : <span class="tok-p">,</span>,
      ]}
    </div>
  )
}

{
  isBranch && n > 0 && (
    <details open class="node" data-path={path} data-kind={isArray ? 'array' : 'object'}>
      <summary class="row">
        {[
          ...keyParts.map((k) => <span class="tok-key">{k}</span>),
          name === undefined ? null : <span class="tok-p colon">:</span>,
          <span class="tok-p">{openBrace}</span>,
          <span class="hint">
            {[
              <span class="tok-p">…{closeBrace}</span>,
              last ? null : <span class="tok-p">,</span>,
              <span class="count" data-count>
                {countLabel}
              </span>,
            ]}
          </span>,
        ]}
      </summary>

      <div class="children" data-children>
        {entries.map(([k, v], i) => (
          <Astro.self name={k} value={v} last={i === n - 1} path={childPath(k, i)} />
        ))}
      </div>

      <div class="row">
        {[<span class="tok-p">{closeBrace}</span>, last ? null : <span class="tok-p">,</span>]}
      </div>
    </details>
  )
}

{
  !isBranch && (
    <div class="row">
      {[
        ...keyParts.map((k) => <span class="tok-key">{k}</span>),
        name === undefined ? null : <span class="tok-p colon">:</span>,
        /* The quotes are punctuation, not content: splitting them out means an
          edit cannot delete them and produce something that is not a string.
          It is also what keeps the editable region exactly the value. */
        ...(typeof value === 'string'
          ? [
              <span class="tok-str">"</span>,
              <span class="tok-str tok-val" data-path={path}>
                {value}
              </span>,
              <span class="tok-str">"</span>,
            ]
          : [<span class={tokenClass(value)}>{literal}</span>]),
        last ? null : <span class="tok-p" data-comma set:text="," />,
      ]}
    </div>
  )
}

<style>
  .row {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* Indentation is structural: each nested level insets its children. */
  .children {
    padding-left: 1.5ch;
  }

  summary {
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* A disclosure arrow that reads as part of the code rather than as UI. */
  summary::before {
    content: '▾';
    display: inline-block;
    width: 1.5ch;
    margin-left: -1.5ch;
    color: var(--color-fg-subtle);
  }

  details:not([open]) > summary::before {
    content: '▸';
  }

  summary:hover::before,
  summary:focus-visible::before {
    color: var(--color-accent);
  }

  /* `…}` and the count only exist while the node is closed. */
  details[open] > summary .hint {
    display: none;
  }

  .count {
    margin-left: 1ch;
    color: var(--color-fg-muted);
    font-style: italic;
  }

  /* Token colours. Punctuation carries structural meaning in JSON, so it uses
     fg-muted (6.0:1) rather than fg-subtle, which fails AA. */
  .tok-key {
    color: var(--color-fg);
  }
  .tok-str {
    color: var(--color-accent);
  }
  .tok-num,
  .tok-bool {
    color: var(--color-accent-soft);
  }
  /* Applied by the editor island, so a value only looks editable once it
     actually is. Only values the page renders get it — editing a field nothing
     displays would demonstrate nothing. */
  .tok-val.is-editable {
    border-bottom: 1px dotted var(--color-border-strong);
    cursor: text;
  }

  .tok-val.is-editable:hover {
    border-bottom-color: var(--color-accent-dim);
  }

  .tok-val.is-editable:focus {
    outline: none;
    background-color: var(--color-accent-faint);
    border-bottom-color: var(--color-accent);
  }

  /* The add/remove controls, injected by the editor island. Sized for the
     24x24 target floor while reading as punctuation rather than as buttons —
     this is a JSON viewer, not a form.
     `:global` is required: Astro scopes component styles by a data-astro-cid
     attribute that these buttons never get, because they are created at runtime
     rather than rendered here. Without it the rule silently does not apply and
     the buttons collapse to 7x19. */
  :global(.json-btn) {
    display: inline-flex;
    min-width: 1.5rem;
    min-height: 1.5rem;
    align-items: center;
    justify-content: center;
    margin-left: 0.75ch;
    border: 1px solid transparent;
    border-radius: 2px;
    background: none;
    padding: 0;
    font-family: inherit;
    font-size: inherit;
    line-height: 1;
    color: var(--color-fg-subtle);
    cursor: pointer;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  :global(.json-btn:hover),
  :global(.json-btn:focus-visible) {
    color: var(--color-accent);
    border-color: var(--color-accent-dim);
  }

  .tok-p {
    color: var(--color-fg-muted);
  }
  .colon {
    margin-right: 0.5ch;
  }
</style>
