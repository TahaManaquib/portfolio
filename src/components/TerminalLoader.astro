---
// Entry point for the terminal. This is the only thing the terminal costs the
// recruiter path: a button plus a small listener. Preact and the panel itself
// are a separate chunk, fetched on the first ⌘K or tap.
//
// The button is visible everywhere. It used to be touch-only, with ⌘K as the
// desktop entry and the source view's JSON as the only signpost — which meant
// the terminal's discoverability rested on a visitor opening the machine view
// and reading it. That is a lot to ask for the site's third pillar, so the
// button is now the entry point on every device and the JSON no longer carries
// a command list. The shortcut still works and is advertised in the tooltip.
---

<button
  type="button"
  class="terminal-open"
  data-terminal-open
  title="Toggle terminal (⌘K)"
  aria-keyshortcuts="Meta+K Control+K"
  aria-expanded="false"
  aria-controls="terminal-panel"
>
  <span class="glyph" aria-hidden="true">&gt;_</span>
  <span class="sr-only">Open terminal</span>
</button>

<script>
  /**
   * **The terminal is desktop-only**, at Taha's request after using the site on
   * a phone. A touch device gets the source view and the achievements panel;
   * the terminal is the reason to come back on a real machine, and the
   * achievements list keeps naming the things it unlocks so the gap is visible
   * rather than silent.
   *
   * The gate is `pointer: coarse` — "the primary pointer is a finger" — rather
   * than a width. A terminal is a typing tool, so the honest question is
   * whether the device has a keyboard, not how many pixels it has; and a phone
   * in landscape is 900px wide, which any width threshold either lets through
   * or pays for by hiding it on small laptops.
   *
   * Checked here as well as in CSS, so the shortcut goes with the button: an
   * iPad with a keyboard attached should not be able to summon a panel it has
   * no way to see it has. Bailing before the listeners are attached also means
   * the chunk can never be fetched on a device that cannot use it.
   */
  const coarse = window.matchMedia('(pointer: coarse)').matches;

  const openers = coarse ? [] : document.querySelectorAll<HTMLElement>('[data-terminal-open]');

  // Cached so the chunk is fetched at most once.
  let pending: Promise<{ open: () => void; close: () => void; isOpen: () => boolean }> | null =
    null;

  function load() {
    pending ??= import('../islands/terminal/mount').then((m) => m.terminal());
    return pending;
  }

  // A toggle, like the source-view and achievements controls beside it. It used
  // to only ever open, which meant the one visible way in had no way out —
  // ⌘K toggled, the button did not, and the same button could be pressed twice
  // with nothing happening the second time.
  function toggle() {
    void load().then((t) => (t.isOpen() ? t.close() : t.open()));
  }

  document.addEventListener('keydown', (event) => {
    if (coarse) return;
    if (!(event.metaKey || event.ctrlKey) || event.altKey) return;
    if (event.key.toLowerCase() !== 'k') return;
    event.preventDefault();
    void load().then((t) => (t.isOpen() ? t.close() : t.open()));
  });

  openers.forEach((el) => el.addEventListener('click', toggle));
</script>

<style>
  .terminal-open {
    position: fixed;
    right: 1rem;
    bottom: 4.5rem;
    z-index: 50;
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: var(--border-w) var(--border-style) var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg);
    color: var(--color-fg-muted);
    cursor: pointer;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .terminal-open:hover {
    color: var(--color-accent);
    border-color: var(--color-accent-dim);
  }

  .terminal-open .glyph {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .terminal-open:focus-visible {
    border-color: var(--color-accent);
  }

  /* Hidden on touch devices — see the note in the script above. CSS as well as
     JS so the button never paints, rather than appearing and then being removed
     once the module has run.

     **Last in the file on purpose.** A media query carries no specificity of
     its own, so this rule and `.terminal-open`'s own `display: inline-flex`
     are an exact tie — and a tie is broken by source order. Written above that
     rule, as it was first, it lost every time and the button stayed visible on
     the phone it was meant to disappear from. */
  @media (pointer: coarse) {
    .terminal-open {
      display: none;
    }
  }
</style>
