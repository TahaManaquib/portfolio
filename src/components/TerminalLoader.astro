---
// Entry point for the terminal. This is the only thing the terminal costs the
// recruiter path: a button plus a small listener. Preact and the panel itself
// are a separate chunk, fetched on the first ⌘K or tap.
//
// The button is visible everywhere. It used to be touch-only, with ⌘K as the
// desktop entry and the source view's JSON as the only signpost — which meant
// the terminal's discoverability rested on a visitor opening the machine view
// and reading it. That is a lot to ask for the site's third pillar, so the
// button is now the entry point on every device and the JSON no longer carries
// a command list. The shortcut still works and is advertised in the tooltip.
---

<button
  type="button"
  class="terminal-open"
  data-terminal-open
  title="Open terminal (⌘K)"
  aria-keyshortcuts="Meta+K Control+K"
>
  <span class="glyph" aria-hidden="true">&gt;_</span>
  <span class="sr-only">Open terminal</span>
</button>

<script>
  const openers = document.querySelectorAll<HTMLElement>('[data-terminal-open]');

  // Cached so the chunk is fetched at most once.
  let pending: Promise<{ open: () => void; close: () => void; isOpen: () => boolean }> | null =
    null;

  function load() {
    pending ??= import('../islands/terminal/mount').then((m) => m.terminal());
    return pending;
  }

  function open() {
    void load().then((t) => t.open());
  }

  document.addEventListener('keydown', (event) => {
    if (!(event.metaKey || event.ctrlKey) || event.altKey) return;
    if (event.key.toLowerCase() !== 'k') return;
    event.preventDefault();
    void load().then((t) => (t.isOpen() ? t.close() : t.open()));
  });

  openers.forEach((el) => el.addEventListener('click', open));
</script>

<style>
  .terminal-open {
    position: fixed;
    right: 1rem;
    bottom: 4.5rem;
    z-index: 50;
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    background-color: var(--color-bg);
    color: var(--color-fg-muted);
    cursor: pointer;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .terminal-open:hover {
    color: var(--color-accent);
    border-color: var(--color-accent-dim);
  }

  .terminal-open .glyph {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .terminal-open:focus-visible {
    border-color: var(--color-accent);
  }
</style>
